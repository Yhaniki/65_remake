  {
   "k": "cfg.server_address.label",
   "v": "伺服器位址"
  },
  {
   "k": "cfg.server_address.help",
   "v": "IP 或主機名（例：192.168.1.10 / dance.example.com）。★留空＝純單機，填了按登入才會去連。"
  },
  {
   "k": "cfg.server_port.label",
   "v": "連線埠"
  },
  {
   "k": "cfg.server_port.help",
   "v": "伺服器 port（1~65535，預設 27015）。要與 server 啟動時的 --port 一致。"
  },
  {
   "k": "cfg.server_password.label",
   "v": "進站密碼"
  },
  {
   "k": "cfg.server_password.help",
   "v": "要與 server 的 --password 一致才連得上。留空＝連到沒設密碼的 server。"
  },
  {
   "k": "cfg.server_token.label",
   "v": "身分 token"
  },
  {
   "k": "cfg.server_token.help",
   "v": "公網伺服器用：密碼是大家共用的門，token 是「伺服器認得的你」。留空＝不帶。"
  },
  {
   "k": "cfg.server_tls.label",
   "v": "TLS 加密連線"
  },
  {
   "k": "cfg.server_tls.help",
   "v": "★開在公網一定要開：不開的話密碼、token、聊天內容全是明文。伺服器要有 --tls-cert。"
  },
  {
   "k": "cfg.server_cert_fingerprint.label",
   "v": "憑證指紋"
  },
  {
   "k": "cfg.server_cert_fingerprint.help",
   "v": "SHA-256（伺服器開機會印出來，冒號可留）。★自簽憑證一定要填，否則驗證必定失敗。留空＝走一般 CA 驗證。"
  },
  {
   "k": "cfg.net_auto_download.label",
   "v": "缺歌自動下載"
  },
  {
   "k": "cfg.net_auto_download.help",
   "v": "座位玩家缺歌時自動從伺服器下載（旁觀者一律不自動下載）。"
  },
  {
   "k": "cfg.net_max_download_mb.label",
   "v": "下載上限 MB"
  },
  {
   "k": "cfg.net_max_download_mb.help",
   "v": "自動下載的單首歌大小上限（1~2048 MB）。超過就只顯示缺歌，避免在慢速網路上卡很久。"
  },
  {
   "k": "cfg.judge_level.label",
   "v": "判定精度"
  },
  {
   "k": "cfg.judge_level.help",
   "v": "StepMania 的「精N」：數字越大越嚴格。精4＝Perfect ±45ms；精2 寬 1.33 倍、精8 只剩 0.33 倍。"
  },
  {
   "k": "cfg.global_offset_ms.label",
   "v": "判定 offset"
  },
  {
   "k": "cfg.global_offset_ms.help",
   "v": "正＝判定時間往後（整體打太早就往正的調）。機器的音訊延遲已自動補掉，這裡只留個人偏好；用編輯器 F2 打拍測試量。"
  },
  {
   "k": "cfg.judge_offset_y.label",
   "v": "判定線位移"
  },
  {
   "k": "cfg.judge_offset_y.help",
   "v": "只影響「看起來要打在哪」，不影響判定時間（那是判定 offset 的事）。0＝正中受擊線。"
  },
  {
   "k": "cfg.scroll_base_bpm.label",
   "v": "速度基準 BPM"
  },
  {
   "k": "cfg.scroll_base_bpm.help",
   "v": "畫面速度 = 這個值 × 速度檔位 × 1.6 px/s。調大＝所有歌所有檔位一起變快（預設 130）。"
  },
  {
   "k": "cfg.speed_steps.label",
   "v": "速度檔位表"
  },
  {
   "k": "cfg.speed_steps.help",
   "v": "房間裡「速度」可以選的檔位清單，逗號分隔（預設 1,1.5,2,2.5,3,4,5,6,8）。"
  },
  {
   "k": "cfg.rank_based_formation.label",
   "v": "依名次調整站位"
  },
  {
   "k": "cfg.rank_based_formation.help",
   "v": "多人同場時，即時分數怎麼影響站位。只換第一名（預設，官方行為）＝只有當下第一名會滑到中央前排（鏡頭錨定的那格），跟他對調的是當下站在那一格的人；其他人一格都不動，所以沒在爭第一名的人整場不會被搬。房間座位順序只決定開局的初始位置。完整名次＝第 k 名站第 k 格，連中段名次也跟著換。不換位＝整場照房間座位順序站。三者都是純本機視覺：分數、判定、結算完全不受影響。"
  },
  {
   "k": "cfg.rank_based_formation.leader",
   "v": "只換第一名(官方)"
  },
  {
   "k": "cfg.rank_based_formation.full",
   "v": "完整名次"
  },
  {
   "k": "cfg.rank_based_formation.off",
   "v": "不換位"
  },
  {
   "k": "cfg.dance_ignore_miss.label",
   "v": "失誤不中斷舞蹈"
  },
  {
   "k": "cfg.dance_ignore_miss.help",
   "v": "開＝跳舞完全不受 combo/miss/血量影響。關（預設）＝官方玩法，斷 combo 會停舞。"
  },
  {
   "k": "cfg.lane_cover.label",
   "v": "擋板圖"
  },
  {
   "k": "cfg.lane_cover.help",
   "v": "蓋在音符板**遠端**（音符進場那一頭）的一張圖，讓音符最後一刻才冒出來 —— 就是 IIDX 的 lane cover。「{0}」＝不蓋（預設）。圖丟進 DATA/ADDON/LANE/（開發樹 assets/LANE/）就會出現在這裡，名字讀同層的 names.tsv。純本機顯示：別人看不到，判定也完全不受影響。"
  },
  {
   "k": "cfg.lane_cover.not_found",
   "v": "{0}(找不到)"
  },
  {
   "k": "cfg.lane_cover_amount.label",
   "v": "擋板長度"
  },
  {
   "k": "cfg.lane_cover_amount.help",
   "v": "擋板伸出來多長，單位是「遠端到受擊器」的百分比（100＝伸到最深，剛好不咬到受擊箭頭；0＝等於沒有擋板）。圖是固定尺寸的一張畫，拉桿只決定露出它下面多少，不會被壓扁。向下模式時擋板改蓋在板頂，但圖本身不會上下顛倒。"
  },
  {
   "k": "cfg.load_external_songs.label",
   "v": "載入外部歌曲"
  },
  {
   "k": "cfg.load_external_songs.help",
   "v": "osu / StepMania / Malody 歌曲的總開關。關掉＝開機不掃歌資料夾、沒有載入進度畫面，只剩官方歌。"
  },
  {
   "k": "cfg.additional_song_folders.label",
   "v": "額外歌曲資料夾"
  },
  {
   "k": "cfg.additional_song_folders.help",
   "v": "分號分隔的絕對路徑（例：D:/test;E:/songs）。每個都當一個 Songs 根：第一層＝分類，第二層＝各首歌。"
  },
  {
   "k": "cfg.addon_folder.label",
   "v": "外掛(ADDON)目錄"
  },
  {
   "k": "cfg.addon_folder.help",
   "v": "留空＝DATA/ADDON。想把整包外掛（SONG/NOTESKIN/THEME/MODEL）放別顆硬碟就填絕對路徑。"
  },
  {
   "k": "cfg.difficulty_calc.label",
   "v": "難度計算方式"
  },
  {
   "k": "cfg.difficulty_calc.help",
   "v": "只影響要自己算難度的外部譜（.gn 一律保留原難度）。選了哪套，顯示數字/隨機難度範圍/簡單普通困難分槽就全照那套。"
  },
  {
   "k": "cfg.difficulty_calc.minacalc",
   "v": "MinaCalc (MSD)"
  },
  {
   "k": "cfg.difficulty_calc.osu",
   "v": "osu! 星數"
  },
  {
   "k": "cfg.song_ui_alpha.label",
   "v": "選歌面板透明度"
  },
  {
   "k": "cfg.song_ui_alpha.help",
   "v": "選歌畫面「資料夾」那個浮動分類瀏覽面板的整體不透明度（0=全透明、1=不透明，預設 0.6）。"
  },
  {
   "k": "cfg.collapse_short_holds.label",
   "v": "極短長條轉單鍵"
  },
  {
   "k": "cfg.collapse_short_holds.help",
   "v": "短於 83ms 的 long note 直接收成單顆 note（頭尾擠在同一個判定窗＝按不出來）。只對外部轉檔譜生效。"
  },
  {
   "k": "cfg.combo_text_scale.label",
   "v": "COMBO 字大小"
  },
  {
   "k": "cfg.combo_text_scale.help",
   "v": "COMBO 字樣＋連段數字的整體大小比例（1.0＝官方原尺寸）。純顯示，不影響判定與分數。"
  },
  {
   "k": "cfg.combo_text_alpha.label",
   "v": "COMBO 字不透明度"
  },
  {
   "k": "cfg.combo_text_alpha.help",
   "v": "字就疊在音符板上，淡一點才不會擋住下落中的音符（預設 60%）。0＝完全看不見。"
  },
  {
   "k": "cfg.combo_text_pop.label",
   "v": "COMBO 字彈跳"
  },
  {
   "k": "cfg.combo_text_pop.help",
   "v": "打中時彈到最大那一瞬間的倍率（官方 2.0＝彈到兩倍再收回，1.0＝完全不彈跳）。"
  },
  {
   "k": "cfg.judge_text_scale.label",
   "v": "判定字大小"
  },
  {
   "k": "cfg.judge_text_scale.help",
   "v": "PERFECT / COOL / BAD / MISS 判定字樣的整體大小比例（1.0＝官方原尺寸）。"
  },
  {
   "k": "cfg.judge_text_alpha.label",
   "v": "判定字不透明度"
  },
  {
   "k": "cfg.judge_text_alpha.help",
   "v": "判定字不會淡出（官方是顯示完直接消失），這個值就是它顯示期間的亮度（預設 60%）。"
  },
  {
   "k": "cfg.judge_text_pop.label",
   "v": "判定字彈跳"
  },
  {
   "k": "cfg.judge_text_pop.help",
   "v": "同 COMBO 字彈跳，只是判定字收回的速度是官方寫死的（比較慢），這裡只調幅度。"
  },
  {
   "k": "cfg.ui_scale.label",
   "v": "UI 縮放"
  },
  {
   "k": "cfg.ui_scale.help",
   "v": "⚠ 目前遊戲還沒有任何地方讀這個值（畫面一律走 800×600 4:3 取景），改了不會有變化 —— 先留著對齊設定檔。"
  },
  {
   "k": "cfg.brightness.label",
   "v": "畫面亮度"
  },
  {
   "k": "cfg.brightness.help",
   "v": "整個畫面的亮度，是「光量倍率」（1×＝原樣、0.5×＝一半的光、2×＝兩倍）。3D 舞台、場景、UI 畫完之後整片一起乘上去，所以暗的地方仍然是暗的，不會泛成灰白。拖著就看得到，要留下來記得按「保存配置」。"
  },
  {
   "k": "cfg.mmd_model.label",
   "v": "使用模型"
  },
  {
   "k": "cfg.mmd_model.help",
   "v": "★選了就是要用它 —— 沒有另外的總開關。第一個選項「{0}」＝維持 SDO 原角色。把整個 MMD 模型資料夾（含 .pmx 與它的貼圖）放進 DATA/MODEL/，開發樹是 assets/MODEL/；一個資料夾＝一個模型，這裡就會出現。"
  },
  {
   "k": "cfg.mmd_model.auto_first",
   "v": "(自動：第一個)"
  },
  {
   "k": "cfg.mmd_model.not_found",
   "v": "{0}(找不到)"
  },
  {
   "k": "cfg.mmd_show_others.label",
   "v": "顯示他人模型"
  },
  {
   "k": "cfg.mmd_show_others.help",
   "v": "開(預設)＝同房的人穿 MMD 模型時，你也看得到（本機沒有就自動跟伺服器下載）。關＝別人一律照他的 SDO 穿搭顯示，而且完全不下載。★這與上面「使用模型」互相獨立：可以自己維持 SDO 角色卻看得到別人的 MMD，也可以反過來。"
  },
  {
   "k": "cfg.mmd_share_model.label",
   "v": "分享模型"
  },
  {
   "k": "cfg.mmd_share_model.help",
   "v": "開(預設)＝把你的模型上傳給伺服器,同房的人也看得到你的 MMD。關＝別人看到的是你的 SDO 穿搭(你自己畫面上仍然是 MMD)。★很多 MMD 模型的使用規約禁止再配布,這個開關就是為此存在的。"
  },
  {
   "k": "cfg.mmd_physics.label",
   "v": "布料物理模擬"
  },
  {
   "k": "cfg.mmd_physics.help",
   "v": "布料模擬（頭髮/裙擺/領帶）。★嫌換場景進遊戲慢就關這個 —— 布料求解是建一隻 MMD 角色最貴的一段。"
  },
