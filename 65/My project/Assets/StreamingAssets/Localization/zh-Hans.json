   "k": "cfg.name.empty",
   "v": "名称不可空白"
  },
  {
   "k": "cfg.name.saved",
   "v": "已保存，进入房间后生效"
  },
  {
   "k": "cfg.server_address.label",
   "v": "服务器地址"
  },
  {
   "k": "cfg.server_address.help",
   "v": "IP 或主机名（例：192.168.1.10 / dance.example.com）。★留空＝纯单机，填了按登录才会去连。"
  },
  {
   "k": "cfg.server_port.label",
   "v": "连接端口"
  },
  {
   "k": "cfg.server_port.help",
   "v": "服务器 port（1~65535，默认 27015）。要与 server 启动时的 --port 一致。"
  },
  {
   "k": "cfg.server_password.label",
   "v": "进站密码"
  },
  {
   "k": "cfg.server_password.help",
   "v": "要与 server 的 --password 一致才连得上。留空＝连到没设密码的 server。"
  },
  {
   "k": "cfg.server_token.label",
   "v": "身份 token"
  },
  {
   "k": "cfg.server_token.help",
   "v": "公网服务器用：密码是大家共用的门，token 是「服务器认得的你」。留空＝不带。"
  },
  {
   "k": "cfg.server_tls.label",
   "v": "TLS 加密连接"
  },
  {
   "k": "cfg.server_tls.help",
   "v": "★开在公网一定要开：不开的话密码、token、聊天内容全是明文。服务器要有 --tls-cert。"
  },
  {
   "k": "cfg.server_cert_fingerprint.label",
   "v": "凭证指纹"
  },
  {
   "k": "cfg.server_cert_fingerprint.help",
   "v": "SHA-256（服务器开机会印出来，冒号可留）。★自签凭证一定要填，否则验证必定失败。留空＝走一般 CA 验证。"
  },
  {
   "k": "cfg.net_auto_download.label",
   "v": "缺歌自动下载"
  },
  {
   "k": "cfg.net_auto_download.help",
   "v": "座位玩家缺歌时自动从服务器下载（旁观者一律不自动下载）。"
  },
  {
   "k": "cfg.net_max_download_mb.label",
   "v": "下载上限 MB"
  },
  {
   "k": "cfg.net_max_download_mb.help",
   "v": "自动下载的单首歌大小上限（1~2048 MB）。超过就只显示缺歌，避免在慢速网络上卡很久。"
  },
  {
   "k": "cfg.judge_level.label",
   "v": "判定精度"
  },
  {
   "k": "cfg.judge_level.help",
   "v": "StepMania 的「精N」：数字越大越严格。精4＝Perfect ±45ms；精2 宽 1.33 倍、精8 只剩 0.33 倍。"
  },
  {
   "k": "cfg.global_offset_ms.label",
   "v": "判定 offset"
  },
  {
   "k": "cfg.global_offset_ms.help",
   "v": "正＝判定时间往后（整体打太早就往正的调）。机器的音频延迟已自动补掉，这里只留个人偏好；用编辑器 F2 打拍测试量。"
  },
  {
   "k": "cfg.judge_offset_y.label",
   "v": "判定线位移"
  },
  {
   "k": "cfg.judge_offset_y.help",
   "v": "只影响「看起来要打在哪」，不影响判定时间（那是判定 offset 的事）。0＝正中受击线。"
  },
  {
   "k": "cfg.scroll_base_bpm.label",
   "v": "速度基准 BPM"
  },
  {
   "k": "cfg.scroll_base_bpm.help",
   "v": "画面速度 = 这个值 × 速度档位 × 1.6 px/s。调大＝所有歌所有档位一起变快（默认 130）。"
  },
  {
   "k": "cfg.speed_steps.label",
   "v": "速度档位表"
  },
  {
   "k": "cfg.speed_steps.help",
   "v": "房间里「速度」可以选的档位清单，逗号分隔（默认 1,1.5,2,2.5,3,4,5,6,8）。"
  },
  {
   "k": "cfg.rank_based_formation.label",
   "v": "依名次调整站位"
  },
  {
   "k": "cfg.rank_based_formation.help",
   "v": "多人同场时，即时分数怎么影响站位。只换第一名（默认，官方行为）＝只有当下第一名会滑到中央前排（镜头锚定的那格），跟他对调的是当下站在那一格的人；其他人一格都不动，所以没在争第一名的人整场不会被搬。房间座位顺序只决定开局的初始位置。完整名次＝第 k 名站第 k 格，连中段名次也跟着换。不换位＝整场照房间座位顺序站。三者都是纯本机视觉：分数、判定、结算完全不受影响。"
  },
  {
   "k": "cfg.rank_based_formation.leader",
   "v": "只换第一名(官方)"
  },
  {
   "k": "cfg.rank_based_formation.full",
   "v": "完整名次"
  },
  {
   "k": "cfg.rank_based_formation.off",
   "v": "不换位"
  },
  {
   "k": "cfg.dance_ignore_miss.label",
   "v": "失误不中断舞蹈"
  },
  {
   "k": "cfg.dance_ignore_miss.help",
   "v": "开＝跳舞完全不受 combo/miss/血量影响。关（默认）＝官方玩法，断 combo 会停舞。"
  },
  {
   "k": "cfg.lane_cover.label",
   "v": "挡板图"
  },
  {
   "k": "cfg.lane_cover.help",
   "v": "盖在音符板**远端**（音符进场那一头）的一张图，让音符最后一刻才冒出来 —— 就是 IIDX 的 lane cover。「{0}」＝不盖（默认）。图丢进 DATA/ADDON/LANE/（开发树 assets/LANE/）就会出现在这里，名字读同层的 names.tsv。纯本机显示：别人看不到，判定也完全不受影响。"
  },
  {
   "k": "cfg.lane_cover.not_found",
   "v": "{0}(找不到)"
  },
  {
   "k": "cfg.lane_cover_amount.label",
   "v": "挡板长度"
  },
  {
   "k": "cfg.lane_cover_amount.help",
   "v": "挡板伸出来多长，单位是「远端到受击器」的百分比（100＝伸到最深，刚好不咬到受击箭头；0＝等于没有挡板）。图是固定尺寸的一张画，拉杆只决定露出它下面多少，不会被压扁。向下模式时挡板改盖在板顶，但图本身不会上下颠倒。"
  },
  {
   "k": "cfg.load_external_songs.label",
   "v": "加载外部歌曲"
  },
  {
   "k": "cfg.load_external_songs.help",
   "v": "osu / StepMania / Malody 歌曲的总开关。关掉＝开机不扫歌文件夹、没有加载进度画面，只剩官方歌。"
  },
  {
   "k": "cfg.additional_song_folders.label",
   "v": "额外歌曲文件夹"
  },
  {
   "k": "cfg.additional_song_folders.help",
   "v": "分号分隔的绝对路径（例：D:/test;E:/songs）。每个都当一个 Songs 根：第一层＝分类，第二层＝各首歌。"
  },
  {
   "k": "cfg.addon_folder.label",
   "v": "插件(ADDON)目录"
  },
  {
   "k": "cfg.addon_folder.help",
   "v": "留空＝DATA/ADDON。想把整包插件（SONG/NOTESKIN/THEME/MODEL）放别颗硬盘就填绝对路径。"
  },
  {
   "k": "cfg.difficulty_calc.label",
   "v": "难度计算方式"
  },
  {
   "k": "cfg.difficulty_calc.help",
   "v": "只影响要自己算难度的外部谱（.gn 一律保留原难度）。选了哪套，显示数字/随机难度范围/简单普通困难分槽就全照那套。"
  },
  {
   "k": "cfg.difficulty_calc.minacalc",
   "v": "MinaCalc (MSD)"
  },
  {
   "k": "cfg.difficulty_calc.osu",
   "v": "osu! 星数"
  },
  {
   "k": "cfg.song_ui_alpha.label",
   "v": "选歌面板透明度"
  },
  {
   "k": "cfg.song_ui_alpha.help",
   "v": "选歌画面「文件夹」那个浮动分类浏览面板的整体不透明度（0=全透明、1=不透明，默认 0.6）。"
  },
  {
   "k": "cfg.collapse_short_holds.label",
   "v": "极短长条转单键"
  },
  {
   "k": "cfg.collapse_short_holds.help",
   "v": "短于 83ms 的 long note 直接收成单颗 note（头尾挤在同一个判定窗＝按不出来）。只对外部转档谱生效。"
  },
  {
   "k": "cfg.combo_text_scale.label",
   "v": "COMBO 字大小"
  },
  {
   "k": "cfg.combo_text_scale.help",
   "v": "COMBO 字样＋连段数字的整体大小比例（1.0＝官方原尺寸）。纯显示，不影响判定与分数。"
  },
  {
   "k": "cfg.combo_text_alpha.label",
   "v": "COMBO 字不透明度"
  },
  {
   "k": "cfg.combo_text_alpha.help",
   "v": "字就叠在音符板上，淡一点才不会挡住下落中的音符（默认 60%）。0＝完全看不见。"
  },
  {
   "k": "cfg.combo_text_pop.label",
   "v": "COMBO 字弹跳"
  },
  {
   "k": "cfg.combo_text_pop.help",
   "v": "打中时弹到最大那一瞬间的倍率（官方 2.0＝弹到两倍再收回，1.0＝完全不弹跳）。"
  },
  {
   "k": "cfg.judge_text_scale.label",
   "v": "判定字大小"
  },
  {
   "k": "cfg.judge_text_scale.help",
   "v": "PERFECT / COOL / BAD / MISS 判定字样的整体大小比例（1.0＝官方原尺寸）。"
  },
  {
   "k": "cfg.judge_text_alpha.label",
   "v": "判定字不透明度"
  },
  {
   "k": "cfg.judge_text_alpha.help",
   "v": "判定字不会淡出（官方是显示完直接消失），这个值就是它显示期间的亮度（默认 60%）。"
  },
  {
   "k": "cfg.judge_text_pop.label",
   "v": "判定字弹跳"
  },
  {
   "k": "cfg.judge_text_pop.help",
   "v": "同 COMBO 字弹跳，只是判定字收回的速度是官方写死的（比较慢），这里只调幅度。"
  },
  {
   "k": "cfg.ui_scale.label",
   "v": "UI 缩放"
  },
  {
   "k": "cfg.ui_scale.help",
   "v": "⚠ 目前游戏还没有任何地方读这个值（画面一律走 800×600 4:3 取景），改了不会有变化 —— 先留着对齐配置文件。"
  },
  {
   "k": "cfg.brightness.label",
   "v": "画面亮度"
  },
  {
   "k": "cfg.brightness.help",
   "v": "整个画面的亮度，是「光量倍率」（1×＝原样、0.5×＝一半的光、2×＝两倍）。3D 舞台、场景、UI 画完之后整片一起乘上去，所以暗的地方仍然是暗的，不会泛成灰白。拖着就看得到，要留下来记得按「保存配置」。"
  },
  {
   "k": "cfg.stage_brightness.label",
   "v": "舞台背景亮度"
  },
  {
   "k": "cfg.stage_brightness.help",
   "v": "只作用在游戏中,而且只动**背景**那一层:舞台本身、道具、场景的人、灯、招牌、场景特效。舞者与人物特效完全不碰,所以拉到 0× 就是「全黑的舞台上只剩人物」。绘制顺序没有动 —— 原本飘在人物前面的彩带、雪还是在人物前面。下一首开局才生效。"
  },
  {
   "k": "cfg.mmd_model.label",
   "v": "使用模型"
  },
  {
   "k": "cfg.mmd_model.help",
   "v": "★选了就是要用它 —— 没有另外的总开关。第一个选项「{0}」＝维持 SDO 原角色。把整个 MMD 模型文件夹（含 .pmx 与它的贴图）放进 DATA/MODEL/，开发树是 assets/MODEL/；一个文件夹＝一个模型，这里就会出现。"
  },
  {
   "k": "cfg.mmd_model.auto_first",
   "v": "(自动：第一个)"
  },
  {
   "k": "cfg.mmd_model.not_found",
   "v": "{0}(找不到)"
  },
  {
   "k": "cfg.mmd_show_others.label",
   "v": "显示他人模型"
  },
  {
   "k": "cfg.mmd_show_others.help",
   "v": "开(默认)＝同房的人穿 MMD 模型时，你也看得到（本机没有就自动跟服务器下载）。关＝别人一律照他的 SDO 穿搭显示，而且完全不下载。★这与上面「使用模型」互相独立：可以自己维持 SDO 角色却看得到别人的 MMD，也可以反过来。"
  },
  {
   "k": "cfg.mmd_share_model.label",
   "v": "分享模型"
  },
  {
   "k": "cfg.mmd_share_model.help",
   "v": "开(默认)＝把你的模型上传给服务器,同房的人也看得到你的 MMD。关＝别人看到的是你的 SDO 穿搭(你自己画面上仍然是 MMD)。★很多 MMD 模型的使用规约禁止再配布,这个开关就是为此存在的。"
  },
  {
   "k": "cfg.mmd_physics.label",
   "v": "布料物理模拟"
  },
  {
   "k": "cfg.mmd_physics.help",
   "v": "布料模拟（头发/裙摆/领带）。★嫌换场景进游戏慢就关这个 —— 布料求解是建一只 MMD 角色最贵的一段。"
  },
  {
   "k": "cfg.mmd_gravity.label",
   "v": "布料重力"
  },
  {
   "k": "cfg.mmd_gravity.help",
