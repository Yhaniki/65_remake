<Project Sdk="Microsoft.NET.Sdk">

  <!-- Verification harness for the MMD rigid-body solver. It compiles the SAME source files the game uses
       (Assets/Scripts/Sdo.MmdPhysics) — there is no second copy of the physics — so a number checked here is
       the number the game runs. Unity is not involved: `dotnet run` finishes in seconds. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Sdo.MmdPhysics.Harness</RootNamespace>
    <AssemblyName>mmd_bullet_port</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\65\My project\Assets\Scripts\Sdo.MmdPhysics\*.cs" />
  </ItemGroup>

</Project>
