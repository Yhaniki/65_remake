<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Sdo.Server — 勁舞團重製版的 standalone 連線伺服器。跑在 Linux(也能在 Windows 跑來測)。

    ★ 關鍵設計:它**直接編譯遊戲實際在用的那份原始碼**(Sdo.Net + Sdo.Osu),不另外寫一份
      協定實作。兩邊各寫一份 parser / 一份房間規則的話，分歧會變成整個專案最難查的那種 bug ——
      封包在 client 看起來對、在 server 看起來對，但兩邊對同一個 byte 的解讀不一樣。
      這個手法沿用 tools\gn_note_export\gn_note_export.csproj(它為了同樣的理由直接編 GnChart.cs)。

    ★ 為什麼 include 整個 Sdo.Osu 而不是逐檔列舉:Sdo.Osu 的 asmdef 是 noEngineReferences，
      整包保證零 UnityEngine 依賴，所以整包都編得過。逐檔列舉的話每次那邊加一個檔就要回來改
      這份 csproj，忘了就是編譯錯誤(而且錯誤訊息會指向缺失的型別，不會告訴你「你忘了更新 csproj」)。
      代價只是多編一些純邏輯檔，net8.0 編起來很快。
      附帶好處:將來 server 若要自己驗譜面(算 note 數、對難度)，整套解析器已經在手上。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>

    <!--
      ⚠️ LangVersion 8.0 不是筆誤。Unity 產生的 csproj 全部是 LangVersion 8.0，
      而 Sdo.Net / Sdo.Osu 的原始碼是兩邊共用的 —— 如果共用檔裡用了 C# 9+ 的語法
      (record、target-typed new、init-only、file-scoped namespace…)，Unity 那邊會編不過。
      在這裡鎖成同一版，讓 `dotnet build` 先把問題擋下來，而不是等到開 Unity 才發現。
    -->
    <LangVersion>8.0</LangVersion>

    <Nullable>disable</Nullable>
    <AssemblyName>sdo-server</AssemblyName>
    <RootNamespace>Sdo.Server</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <!-- 把警告當回事:協定層的型別/精度警告通常代表真的寫錯了。 -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>

    <!--
      🔴 **這一行是部署能不能活的關鍵。**

      `PublishSingleFile=true` 預設**不會**把 native 函式庫收進那顆單一檔 —— 它會把
      `libe_sqlite3.so`(Microsoft.Data.Sqlite 的 native 後端)放在**執行檔旁邊**。
      而 DEPLOY.md 的部署動作是「scp 那一個檔上去」,所以少了這行的結果是:
      server 照常啟動、照常收人,只有玩家快照靜靜地開不起來(log 裡一行 ⚠️),
      而症狀「離線的人查不到資料」與功能沒做完長得一模一樣。

      設 true 之後 native lib 被塞進單一檔,host 在啟動時自己解出來 → 部署指令一個字都不用改。
      驗證方法:publish 完的目錄裡除了 `sdo-server`(與 .pdb)不該再有 `.so`。
    -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!--
      玩家資料快照的落地層(<data>/players.db,見 Store/PlayerStore.cs)。

      ⚠️ 這是 server 的**第一個也是唯一一個** NuGet 依賴,而部署是
      `PublishSingleFile=true` 的 self-contained 單一檔 —— native 的 e_sqlite3 會被包進那顆檔,
      執行時由 host 自己解出來。所以 DEPLOY.md 的指令**一個字都不用改**。
      版本鎖在 8.0.x:與 TargetFramework 同一條線,不要為了一個 key-value 表把 runtime 相依拉高。
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />

    <!-- server 自己的程式碼 -->
    <Compile Include="**/*.cs" Exclude="bin/**;obj/**" />

    <!-- 與遊戲共用的協定 + 房間規則(純邏輯，零 UnityEngine) -->
    <Compile Include="../../65/My project/Assets/Scripts/Sdo.Net/**/*.cs" />

    <!--
      與遊戲共用的歌曲解析 / 指紋 / 過濾(同上)。

      ⚠️ 排除清單:Sdo.Osu 雖然是 noEngineReferences(沒有 UnityEngine),但**不代表它零外部依賴** ——
      少數幾個檔用了放在 Unity Plugins 底下的 managed DLL。server 完全不需要那些功能，直接排掉。
      (這是實際編過才發現的:一開始以為整包都能編。)

        AudioDuration.cs  → NLayer(mp3 解碼)。server 不需要知道音檔多長。
    -->
    <Compile Include="../../65/My project/Assets/Scripts/Sdo.Osu/**/*.cs"
             Exclude="../../65/My project/Assets/Scripts/Sdo.Osu/AudioDuration.cs" />

    <!--
      版本字串的 formatter。**單獨挑這一個檔**(它刻意寫成 UnityEngine-free,見檔頭)——
      Assets/Scripts/Game 底下其他檔滿是 UnityEngine 依賴,整包 include 會編不過。
      共用它的理由:server 印的版本要與 client 視窗標題長得一樣,才能一眼比對兩邊是不是同一個 commit。
    -->
    <Compile Include="../../65/My project/Assets/Scripts/Game/BuildTitle.cs" />

    <!--
      測試專案是 ProjectReference(不是把原始碼再編一份),所以 internal 的純函式
      (BuildInfo.Sane / Compose 那些)跨 assembly 是看不見的 —— 開這道門而不是把它們改成 public:
      它們是實作細節,只有測試需要直接戳。
    -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Sdo.Server.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    編譯時把 git 狀態戳進 assembly metadata,啟動 banner 才印得出「這顆 binary 是哪個 commit」
    (見 BuildInfo.cs —— 沒有它的話,「server 沒換到新版」與「新功能有 bug」的症狀無法區分)。

    ⚠️ 三個 git 指令都可能失敗(不在 tag 上是常態、從 tarball 建則完全沒有 .git),所以:
      * stderr 丟掉 —— ConsoleToMSBuild 會把 stderr 一起收進 ConsoleOutput,
        「fatal: no tag exactly matches …」會直接變成版本字串的一部分。
      * IgnoreExitCode + ContinueOnError —— git 失敗絕對不可以讓 build 失敗。
      * C# 端還有一道 BuildInfo.Sane(tag/hash 不含空白)兜底。
  -->
  <Target Name="SdoStampGitVersion" BeforeTargets="GetAssemblyAttributes">
    <PropertyGroup>
      <SdoNul Condition="'$(OS)' == 'Windows_NT'">NUL</SdoNul>
      <SdoNul Condition="'$(OS)' != 'Windows_NT'">/dev/null</SdoNul>
    </PropertyGroup>

    <Exec Command="git describe --tags --exact-match HEAD 2&gt;$(SdoNul)"
          WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true"
          IgnoreExitCode="true" ContinueOnError="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="SdoGitExactTag" />
    </Exec>
    <Exec Command="git describe --tags --abbrev=0 2&gt;$(SdoNul)"
          WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true"
          IgnoreExitCode="true" ContinueOnError="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="SdoGitNearestTag" />
    </Exec>
    <Exec Command="git rev-parse --short=5 HEAD 2&gt;$(SdoNul)"
          WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true"
          IgnoreExitCode="true" ContinueOnError="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="SdoGitHash5" />
    </Exec>

    <ItemGroup>
      <AssemblyMetadata Include="GitExactTag" Value="$(SdoGitExactTag)" />
      <AssemblyMetadata Include="GitNearestTag" Value="$(SdoGitNearestTag)" />
      <AssemblyMetadata Include="GitHash5" Value="$(SdoGitHash5)" />
    </ItemGroup>
  </Target>
</Project>
